CENTER_TOKEN=replace-with-your-own-long-random-secret
# 默认监听所有 IPv4 网卡；访问时使用 localhost 或中心电脑的可达 IP。
CENTER_HOST=0.0.0.0
# 留空时，终端使用 UDP 探测回复的来源 IP，无需固定局域网地址。
CENTER_ADVERTISE_URL=
# 仅反向代理或 NAT 需要固定连接入口时填写，例如 https://driver.example.com。
# 通告地址不影响监听或访问来源；不要填写 0.0.0.0。

# Compose 自动启用 H.264/WebRTC，并连接内部 MediaMTX 服务。
# 本机 uv 启动时需另行运行 MediaMTX，或设置为 0 仅使用训练 API。
# CENTER_MEDIA_ENABLED=1
# CENTER_MEDIA_HTTP_URL=http://127.0.0.1:8889
# 通常按浏览器访问地址自动生成 ICE，无需固定主机。
# CENTER_MEDIA_ICE_HOST=video.example.com
