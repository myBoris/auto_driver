# 与 center/.env 中的 CENTER_TOKEN 完全一致，用于终端自动配对。
CENTER_TOKEN=replace-with-your-private-pairing-token

# 硬件 H.264 视频目标帧率，范围 1..120；实际帧率受游戏/硬件/网络影响。
TERMINAL_FPS=60

# AI JPEG 观察独立采样，避免每个视频帧都压缩 JPEG。
TERMINAL_OBSERVATION_FPS=10
TERMINAL_VIDEO_ENABLED=true
# 视频码率 bit/s，8M 表示 8,000,000 bit/s。
TERMINAL_VIDEO_BITRATE=8M
# auto 实际探测 NVENC/QSV/AMF；失败明确报错，无软件回退。
TERMINAL_VIDEO_ENCODER=auto

# FH5 Data Out 被动 UDP 监听；游戏中开启 Data Out，目标 IP/端口设为这里。
TERMINAL_TELEMETRY_ENABLED=true
TERMINAL_TELEMETRY_HOST=127.0.0.1
TERMINAL_TELEMETRY_PORT=5300
# 可选覆盖；默认使用 uv 安装的 imageio-ffmpeg 附带 FFmpeg。
# FFMPEG_BINARY=C:/tools/ffmpeg.exe

# 默认通过局域网 UDP 自动发现中心；通常无需填写。
# CENTER_URL=http://192.168.1.10:8000

# 多终端时可设置固定唯一标识，默认使用电脑主机名。
# TERMINAL_ID=game-pc
